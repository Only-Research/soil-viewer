{
  "name": "soil-viewer",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "A local-first workspace over a folder tree of markdown files. The tree is the state: a task's status is the folder it sits in, and the editor returns every file byte-identical.",
  "keywords": [
    "markdown",
    "local-first",
    "editor",
    "kanban",
    "notes",
    "file-tree",
    "self-hosted"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "harness:corpus": "node test/harness/scan-corpus.cjs",
    "harness:gate": "playwright test --config playwright.harness.config.ts",
    "mock:soil": "node test/support/mock-soil/cli.ts",
    "ci": "npm run typecheck && npm run lint && npm run build && npm run test && npm run test:e2e && npm run mock:soil && npm run harness:corpus && npm run harness:gate",
    "build:server": "vite build --config vite.server.config.ts",
    "serve": "node dist-server/main.js",
    "open": "bash ../start-soil-viewer.command",
    "always-on": "bash ops/install-always-on.sh",
    "always-on:off": "bash ops/remove-always-on.sh",
    "always-on:restart": "launchctl kickstart -k gui/$(id -u)/com.soilviewer.server",
    "build:e2e": "tsc --noEmit && vite build --outDir ../../dist-e2e --emptyOutDir && vite build --config vite.server.config.ts --outDir dist-server-e2e --emptyOutDir",
    "serve:e2e": "SOIL_DIST_DIR=dist-e2e node dist-server-e2e/main.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@lezer/markdown": "1.7.2",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
