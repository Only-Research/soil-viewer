# THE REGISTRY IS CLOSED BY DEFAULT IN THIS REPOSITORY.
#
# Added 2026-08-07 after The builder ran `npx tsx` during a security review and pulled three packages
# from registry.npmjs.org unauthorised — ten minutes after instructing another agent not to. Nothing
# executed (`ignore-scripts=true` is set globally on this machine) and nothing reached the project,
# but the control that was supposed to prevent it was a sentence in a document, which is the exact
# failure mode this build exists to argue against. The security review's ruling,
# `the supply-chain incident record`, action 1.
#
# WHY A FILE AND NOT A RULE. The command sandbox already denies network access and writes under
# `~/.npm` — and it was off, because this build needs to bind loopback sockets routinely (56 tests)
# and `dangerouslyDisableSandbox` is a single all-or-nothing switch. Opening it to bind a port
# silently surrenders every other restriction it carries. A repo `.npmrc` is a property of the
# filesystem rather than of process sandbox state, so it holds either way. That is the whole point:
# the floor must not be the sandbox, and it must not be anybody's memory.
#
# WHAT THIS DOES. Any npm or npx command that would need to reach a registry fails instead of
# fetching. Everything already in `node_modules` and in the local npm cache still works, which is
# every command this build actually runs — install, test, lint, build, Playwright.
#
# TO INSTALL DELIBERATELY, the path is explicit and auditable rather than accidental:
#
#     npm ci --ignore-scripts --no-offline
#
# CI passes exactly that, because CI starts from a cold cache and genuinely must fetch. A deliberate
# install is a decision someone typed; an accidental one is now an error.
offline=true

# Belt and braces with the machine-wide setting, so this repository does not depend on a global
# config staying put. This is what made the incident inert rather than an execution event.
ignore-scripts=true
